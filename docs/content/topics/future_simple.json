  "level": 3,
  "theory": {
    "sections": [
      {
        "title": "Что такое Future Simple?",
        "content": "Future Simple (будущее простое) описывает действия, которые произойдут в будущем. Используем:\n• Для спонтанных решений (I'll help you)\n• Для прогнозов (It will rain tomorrow)\n• Для обещаний (I will call you later)\n• Для предположений (I think she will come)",
        "examples": [
          {
            "en": "I will help you.",
            "ru": "Я помогу тебе."
          },
          {
            "en": "It will rain tomorrow.",
            "ru": "Завтра будет дождь."
          }
        ]
      },
      {
        "title": "Утвердительное предложение",
        "content": "Строится с помощью will + V1. Will одинаков для всех лиц. Сокращённая форма: I'll, you'll, he'll и т.д.",
        "formula": "Subject + will + V1",
        "examples": [
          {
            "en": "I will travel to Japan.",
            "ru": "Я поеду в Японию."
          },
          {
            "en": "She'll be a great doctor.",
            "ru": "Она будет отличным врачом."
          },
          {
            "en": "They will arrive soon.",
            "ru": "Они скоро прибудут."
          }
        ]
      },
      {
        "title": "Отрицание и вопросы",
        "content": "Отрицание: will not = won't. Вопрос: Will + subject + V1?",
        "formula": "Отрицание: Subject + won't + V1\nВопрос: Will + subject + V1?",
        "examples": [
          {
            "en": "I won't be late.",
            "ru": "Я не опоздаю."
          },
          {
            "en": "Will you come to the party?",
            "ru": "Ты придёшь на вечеринку?"
          },
          {
            "en": "She won't forget.",
            "ru": "Она не забудет."
          }
        ],
        "tip": "won't — это сокращение от will not."
      },
      {
        "title": "Слова-маркеры",
        "content": "tomorrow (завтра), next week/month/year, soon (скоро), in the future, I think/I believe, probably, perhaps.",
        "examples": [
          {
            "en": "I'll see you next Monday.",
            "ru": "Увидимся в следующий понедельник."
          },
          {
            "en": "She will probably agree.",
            "ru": "Она, вероятно, согласится."
          }
        ]
      }
    ]
  },
