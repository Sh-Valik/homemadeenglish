  "id": "pronouns",
  "title": "Pronouns",
  "title_ru": "Местоимения",
  "icon": "👤",
  "level": 11,
  "theory": {
    "sections": [
      {
        "title": "Объектные местоимения",
        "content": "Объектные местоимения отвечают на вопросы 'кому?', 'кого?', 'кем?'. Они стоят после глагола или предлога.",
        "formula": "I -> me, you -> you, he -> him, she -> her, it -> it, we -> us, they -> them",
        "examples": [
          {
            "en": "I love him.",
            "ru": "Я люблю его."
          },
          {
            "en": "Look at us!",
            "ru": "Посмотри на нас!"
          }
        ]
      },
      {
        "title": "Притяжательные местоимения-прилагательные",
        "content": "Отвечают на вопрос 'чей?' и всегда стоят ПЕРЕД существительным.",
        "formula": "my (мой), your (твой), his (его), her (ее), its (его/ее для неодуш.), our (наш), their (их)",
        "examples": [
          {
            "en": "This is my car.",
            "ru": "Это моя машина."
          },
          {
            "en": "Where is your brother?",
            "ru": "Где твой брат?"
          }
        ]
      },
      {
        "title": "Абсолютные притяжательные местоимения",
        "content": "Тоже отвечают на вопрос 'чей?', но используются БЕЗ существительного после них. Они заменяют фразу 'мой [предмет]'.",
        "formula": "mine, yours, his, hers, ours, theirs",
        "examples": [
          {
            "en": "This car is mine.",
            "ru": "Эта машина — моя. (Без слова 'машина' в конце)"
          },
          {
            "en": "Is this book yours?",
            "ru": "Эта книга твоя?"
          }
        ]
      }
    ]
  },
