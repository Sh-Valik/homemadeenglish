{
  "id": "prepositions",
  "title": "Prepositions",
  "title_ru": "Предлоги in / on / at",
  "icon": "📍",
  "level": 6,
  "theory": {
    "sections": [
      {
        "title": "Предлоги места и времени",
        "content": "Предлоги in, on, at — одни из самых частых в английском языке. Они используются и для места, и для времени, но по разным правилам.",
        "examples": [
          {
            "en": "I live in Moscow.",
            "ru": "Я живу в Москве."
          },
          {
            "en": "The book is on the table.",
            "ru": "Книга на столе."
          },
          {
            "en": "Meet me at the station.",
            "ru": "Встреть меня на станции."
          }
        ]
      },
      {
        "title": "Предлоги времени",
        "content": "AT — точное время и праздники:\n• at 5 o'clock, at noon, at midnight, at night, at Christmas, at the weekend\n\nON — дни и даты:\n• on Monday, on July 5th, on my birthday, on Christmas Day\n\nIN — месяцы, годы, сезоны, части дня:\n• in January, in 2024, in summer, in the morning/afternoon/evening",
        "examples": [
          {
            "en": "I wake up at 7 AM.",
            "ru": "Я просыпаюсь в 7 утра."
          },
          {
            "en": "The meeting is on Friday.",
            "ru": "Встреча в пятницу."
          },
          {
            "en": "She was born in May.",
            "ru": "Она родилась в мае."
          }
        ],
        "tip": "Запомните: at night (НЕ in night), но in the morning/afternoon/evening."
      },
      {
        "title": "Предлоги места",
        "content": "IN — внутри чего-то (закрытое пространство, города, страны):\n• in the room, in Moscow, in Russia, in the box\n\nON — на поверхности:\n• on the table, on the wall, on the floor, on the street\n\nAT — в точке, по адресу, в конкретном месте:\n• at home, at work, at school, at the bus stop, at 25 Oxford Street",
        "examples": [
          {
            "en": "The keys are in the bag.",
            "ru": "Ключи в сумке."
          },
          {
            "en": "The picture is on the wall.",
            "ru": "Картина на стене."
          },
          {
            "en": "She is at work.",
            "ru": "Она на работе."
          }
        ],
        "tip": "at home, at work, at school — устойчивые выражения (без the)."
      },
      {
        "title": "Особые случаи",
        "content": "• in the car / in a taxi, НО on the bus / on the train / on the plane\n• at the top / at the bottom, НО on the left / on the right\n• in the photo / in the picture\n• on TV / on the radio / on the Internet\n• at the beginning / at the end",
        "examples": [
          {
            "en": "I saw it on TV.",
            "ru": "Я видел это по телевизору."
          },
          {
            "en": "She is in the car.",
            "ru": "Она в машине."
          },
          {
            "en": "He is on the bus.",
            "ru": "Он в автобусе."
          }
        ]
      }
    ]
  },
