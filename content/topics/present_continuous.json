{
  "id": "present_continuous",
  "title": "Present Continuous",
  "title_ru": "Настоящее длительное время",
  "icon": "🔄",
  "level": 4,
  "theory": {
    "sections": [
      {
        "title": "Что такое Present Continuous?",
        "content": "Present Continuous описывает действия, которые происходят прямо сейчас, в момент речи, или временные ситуации.\n\nИспользуем:\n• Действие прямо сейчас (I am reading a book now)\n• Временные ситуации (She is staying with friends this week)\n• Запланированное будущее (We are meeting tomorrow)\n• Раздражающие привычки с always (He is always losing his keys)",
        "examples": [
          {
            "en": "I am reading a book now.",
            "ru": "Я сейчас читаю книгу."
          },
          {
            "en": "She is cooking dinner.",
            "ru": "Она готовит ужин."
          }
        ]
      },
      {
        "title": "Формула",
        "content": "Present Continuous строится с помощью глагола to be (am/is/are) + глагол с окончанием -ing.",
        "formula": "I am + Ving\nHe/She/It is + Ving\nYou/We/They are + Ving",
        "examples": [
          {
            "en": "I am working.",
            "ru": "Я работаю (сейчас)."
          },
          {
            "en": "He is sleeping.",
            "ru": "Он спит."
          },
          {
            "en": "They are playing.",
            "ru": "Они играют."
          }
        ],
        "tip": "Сокращения: I'm, he's, she's, it's, we're, you're, they're."
      },
      {
        "title": "Правила добавления -ing",
        "content": "• Обычно: work → working, read → reading\n• Глагол на -e: make → making, write → writing (убираем -e)\n• Короткий CVC: run → running, sit → sitting (удваиваем последнюю согласную)\n• Глагол на -ie: lie → lying, die → dying (ie → y + ing)",
        "examples": [
          {
            "en": "make → making",
            "ru": "убираем -e"
          },
          {
            "en": "run → running",
            "ru": "удваиваем n"
          },
          {
            "en": "lie → lying",
            "ru": "ie → y"
          }
        ]
      },
      {
        "title": "Отрицание и вопросы",
        "content": "Отрицание: am/is/are + not + Ving. Вопрос: Am/Is/Are + subject + Ving?",
        "formula": "Отрицание: Subject + am/is/are + not + Ving\nВопрос: Am/Is/Are + subject + Ving?",
        "examples": [
          {
            "en": "I am not watching TV.",
            "ru": "Я не смотрю телевизор."
          },
          {
            "en": "Is she studying?",
            "ru": "Она учится?"
          },
          {
            "en": "They aren't coming.",
            "ru": "Они не приходят."
          }
        ]
      },
      {
        "title": "Глаголы состояния (State verbs)",
        "content": "Некоторые глаголы НЕ используются в Continuous! Это глаголы, описывающие состояния, а не действия: know, like, love, hate, want, need, believe, understand, remember, belong, seem.",
        "examples": [
          {
            "en": "I know the answer. ✅",
            "ru": "Я знаю ответ."
          },
          {
            "en": "I am knowing the answer. ❌",
            "ru": "Неправильно!"
          }
        ],
        "tip": "I'm loving it — исключение (рекламный слоган McDonald's), в обычной речи — I love it."
      }
    ]
  },
